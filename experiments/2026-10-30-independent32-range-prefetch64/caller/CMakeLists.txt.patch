--- CMakeLists.txt@968361dbcceabecdb2eb17daf069dee058c28bb4
+++ CMakeLists.txt
@@ -1,5 +1,5 @@
 cmake_minimum_required(VERSION 3.18)
-project(independent32_range_public_panel LANGUAGES CXX)
+project(independent32_prefetch64_public_panel LANGUAGES CXX)
 set(CMAKE_CXX_STANDARD 17)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
@@ -17,7 +17,15 @@
 endforeach()
 add_executable(main main.cpp)
 target_include_directories(main BEFORE PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}" "${FASTFILTER}" "${BOOST}")
-target_compile_options(main PRIVATE -fno-strict-aliasing -march=native)
+target_compile_options(main PRIVATE -fno-strict-aliasing)
+set(BF_ISA "native" CACHE STRING "native or avx2")
+if(BF_ISA STREQUAL "native")
+  target_compile_options(main PRIVATE -march=native)
+elseif(BF_ISA STREQUAL "avx2")
+  target_compile_options(main PRIVATE -march=x86-64-v3)
+else()
+  message(FATAL_ERROR "unsupported fixed ISA profile")
+endif()
 if(BF_SANITIZERS)
   target_compile_options(main PRIVATE -O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer)
   target_link_options(main PRIVATE -fsanitize=address,undefined)
