{
  "cpu": 2,
  "flock": "/tmp/fastest-bf-socket0.lock",
  "commands": [
    [
      "strong-fmt.log",
      [
        "cargo",
        "fmt",
        "--manifest-path",
        "experiments/2026-10-29-rust-single-api/benchmark-strong/Cargo.toml"
      ]
    ],
    [
      "strong-normal-test.log",
      [
        "env",
        "CARGO_TARGET_DIR=/tmp/fastest-bf-rust-single-api-strong",
        "RUST_TEST_THREADS=1",
        "cargo",
        "test",
        "--manifest-path",
        "experiments/2026-10-29-rust-single-api/benchmark-strong/Cargo.toml",
        "single_api_tests",
        "--",
        "--nocapture"
      ]
    ],
    [
      "strong-disable-test.log",
      [
        "env",
        "CARGO_TARGET_DIR=/tmp/fastest-bf-rust-single-api-strong-disable",
        "RUST_TEST_THREADS=1",
        "cargo",
        "test",
        "--manifest-path",
        "experiments/2026-10-29-rust-single-api/benchmark-strong/Cargo.toml",
        "--features",
        "disable-avx512",
        "single_api_tests",
        "--",
        "--nocapture"
      ]
    ],
    [
      "strong-asan-test.log",
      [
        "env",
        "CARGO_TARGET_DIR=/tmp/fastest-bf-rust-single-api-strong-asan",
        "RUST_TEST_THREADS=1",
        "RUSTFLAGS=-Zsanitizer=address",
        "cargo",
        "+nightly",
        "test",
        "--target",
        "x86_64-unknown-linux-gnu",
        "--manifest-path",
        "experiments/2026-10-29-rust-single-api/benchmark-strong/Cargo.toml",
        "single_api_tests",
        "--",
        "--nocapture"
      ]
    ],
    [
      "strong-release-build.log",
      [
        "env",
        "CARGO_TARGET_DIR=/tmp/fastest-bf-rust-single-api-strong",
        "RUSTFLAGS=-C target-cpu=native",
        "cargo",
        "build",
        "--release",
        "--manifest-path",
        "experiments/2026-10-29-rust-single-api/benchmark-strong/Cargo.toml"
      ]
    ]
  ]
}
