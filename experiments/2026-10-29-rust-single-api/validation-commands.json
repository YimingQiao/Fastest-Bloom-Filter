{
  "cpu": 2,
  "flock": "/tmp/fastest-bf-socket0.lock",
  "commands": [
    [
      "fmt.log",
      [
        "cargo",
        "fmt",
        "--manifest-path",
        "experiments/2026-10-29-rust-single-api/benchmark/Cargo.toml"
      ]
    ],
    [
      "normal-test.log",
      [
        "env",
        "CARGO_TARGET_DIR=/tmp/fastest-bf-rust-single-api",
        "RUST_TEST_THREADS=1",
        "cargo",
        "test",
        "--manifest-path",
        "experiments/2026-10-29-rust-single-api/benchmark/Cargo.toml",
        "single_api_tests",
        "--",
        "--nocapture"
      ]
    ],
    [
      "disable-test.log",
      [
        "env",
        "CARGO_TARGET_DIR=/tmp/fastest-bf-rust-single-api-disable",
        "RUST_TEST_THREADS=1",
        "cargo",
        "test",
        "--manifest-path",
        "experiments/2026-10-29-rust-single-api/benchmark/Cargo.toml",
        "--features",
        "disable-avx512",
        "single_api_tests",
        "--",
        "--nocapture"
      ]
    ],
    [
      "asan-test.log",
      [
        "env",
        "CARGO_TARGET_DIR=/tmp/fastest-bf-rust-single-api-asan",
        "RUST_TEST_THREADS=1",
        "RUSTFLAGS=-Zsanitizer=address",
        "cargo",
        "+nightly",
        "test",
        "--target",
        "x86_64-unknown-linux-gnu",
        "--manifest-path",
        "experiments/2026-10-29-rust-single-api/benchmark/Cargo.toml",
        "single_api_tests",
        "--",
        "--nocapture"
      ]
    ],
    [
      "release-build.log",
      [
        "env",
        "CARGO_TARGET_DIR=/tmp/fastest-bf-rust-single-api",
        "RUSTFLAGS=-C target-cpu=native",
        "cargo",
        "build",
        "--release",
        "--manifest-path",
        "experiments/2026-10-29-rust-single-api/benchmark/Cargo.toml"
      ]
    ]
  ]
}
