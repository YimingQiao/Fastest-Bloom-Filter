    "source_sha256": "0cb04205257f37812cc728661a915bb0a61525bc6a713af4a3e5201da4d28ae1",
    "replacements": [
      {
        "old": "using namespace bloom_filters;",
        "new": "#include \"geometry.hpp\"\nusing namespace bloom_filters;",
        "count": 1
      },
      {
        "old": "return BF(n, bpk);",
        "new": "return exact_budget::Traits<BF>::Make(n, bpk);",
        "count": 1
      },
      {
        "old": "\tBF bf = make_filter<BF>(n, bpk);",
        "new": "\tconst auto geometry = exact_budget::Traits<BF>::Plan(n, bpk);\n\tBF bf = make_filter<BF>(n, bpk);\n\tif (bf.SizeInBytes() != geometry.allocated_bytes || bf.SizeInBytes() > geometry.budget_bytes)\n\t\tthrow std::runtime_error(\"allocation disagrees with exact geometry plan\");",
        "count": 1
      },
      {
        "old": "    samples(pure_parallel,!RawKeyApi<BF>::value); samples(hash_parallel,true);\n    std::cout << '\\n';",
        "new": "    samples(pure_parallel,!RawKeyApi<BF>::value); samples(hash_parallel,true);\n    std::cout << ','; exact_budget::PrintGeometry(std::cout,geometry);\n    std::cout << \",exact_byte_ceiling_v1,fixed_serial_pure_serial_hash_parallel_pure_parallel_hash,\";\n    for(size_t i=0;i<lookup.size();++i) { if(i)std::cout<<'|'; if constexpr(RawKeyApi<BF>::value)std::cout<<\"nan\"; else std::cout<<lookup[i]; }\n    std::cout<<',';\n    for(size_t i=0;i<total.size();++i) { if(i)std::cout<<'|'; std::cout<<total[i]; }\n    std::cout << '\\n';",
        "count": 1
      },
      {
        "old": "        std::cout << '\\n';\n\t\tshuffle(jobs, rng);",
        "new": "        std::cout << ',' << exact_budget::GeometryHeader() << \",size_contract,query_phase_order,lookup_trials_ns,hash_lookup_trials_ns\\n\";\n\t\tshuffle(jobs, rng);",
        "count": 1
      },
      {
        "old": "\tstd::cout << \"cpp,\"",
        "new": "\tstd::cout << std::setprecision(17) << \"cpp,\"",
        "count": 1
      },
      {
        "old": "std::setprecision(12)",
        "new": "std::setprecision(17)",
        "count": 1
      }
    ]
  },
