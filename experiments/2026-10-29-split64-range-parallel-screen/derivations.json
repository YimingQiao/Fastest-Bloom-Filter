  "check_adapters.cpp": {
    "source": "experiments/2026-10-29-external-parallel-query/check_adapters.cpp",
    "revision": "381238bba3cceae72d80bb2be59710021940d1c4",
    "source_sha256": "9f5ae36616746dd43f3f7f5c3518a8f13a9df6cefad7f44efe6afecd8e8b5290",
    "replacements": [
      {
        "old": "#include \"adapters.hpp\"",
        "new": "#include \"geometry.hpp\"",
        "count": 1
      },
      {
        "old": "    BF building(n,8); building.Insert(n,keys.data());",
        "new": "    for (uint32_t budget : {16u,24u,32u}) {\n    const auto geometry=exact_budget::Traits<BF>::Plan(n,budget);\n    BF building=exact_budget::Traits<BF>::Make(n,budget);\n    Require(building.SizeInBytes()==geometry.allocated_bytes && building.SizeInBytes()<=geometry.budget_bytes,\"actual exact allocation\");\n    building.Insert(n,keys.data());",
        "count": 1
      },
      {
        "old": "\n}\nint main() {",
        "new": "\n    }\n}\nint main() {",
        "count": 1
      },
      {
        "old": "\n    Check<bloom_filters::FastPatternBF>();Check<FourSectorBloomFilter>();Check<Split64BloomFilter>();Check<ByteSplitBloomFilter>();\n    Check<FastFilterFixed16>();Check<FastFilterFixed16SingleV1>();Check<FastFilterFixed32Bulk>();Check<FastFilterSimdBlock>();Check<FastFilterSimdBlockSingleV1>();\n    Check<Boost192Multi64K8>();Check<Boost192ClassicK11>();\n    Check<RocksDBFastLocalBloom64>();Check<RocksDBFastLocalBloom64K8Batch32>();Check<PageBloom6Default>();\n    std::cout<<\"Fourteen native/external immutable adapter types match full serial outputs at T=1/3/8 and batch=1/7/31/4096.\\n\";\n}\n",
        "new": "\n#define ADD(T, H) Check<T>()\n    ADD(bloom_filters::FastPatternBF, uint64_t);\n    BF_REGISTER_EXTERNAL_FILTERS(ADD);\n#undef ADD\n    std::cout << \"All25 fixed native/external adapter types match complete serial outputs at exact16/24/32 caps, T=1/3/8 and batch=1/7/31/4096.\\n\";\n}\n",
        "count": 1
      }
    ]
  }
