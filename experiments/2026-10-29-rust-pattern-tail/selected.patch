+    #[test]
+    fn masked_tails_match_scalar_and_frozen_before() {
+        for (n, bpk) in [(65539, 4), (65539, 8), (1 << 20, 16)] {
+            let mut old = crate::before::BloomFilter::<true>::new(n, bpk).unwrap();
+            let mut new = BloomFilter::<true>::new(n, bpk).unwrap();
+            let mut inserted: Vec<_> = (0..65539).map(hash64).collect();
+            inserted.extend((0..1024).map(|i| (7u64 << 32) | (hash64(i) & 0xffff_ffff)));
+            inserted.extend([0, u64::MAX]);
+            old.insert_hashes(&inserted);
+            new.insert_hashes(&inserted);
+            let bitmap: Vec<_> = new.lines.iter().flat_map(|line| line.0).collect();
+            assert!(inserted.iter().all(|&h| new.contains_hash(h)));
+            for len in (0..=131).chain([4096, 4097, 4100, 4103]) {
+                for offset in 0..16 {
+                    let input: Vec<_> = (0..len + offset)
+                        .map(|i| {
+                            if i % 3 == 0 {
+                                inserted[i % inserted.len()]
+                            } else {
+                                hash64(1_000_000 + i as u64)
+                            }
+                        })
+                        .collect();
+                    let input = &input[offset..];
+                    let mut actual = vec![0xfeed; len + 2];
+                    let mut expected = vec![0xfeed; len + 2];
+                    old.lookup_hashes(input, &mut expected[1..len + 1]);
+                    new.lookup_hashes(input, &mut actual[1..len + 1]);
+                    assert_eq!(
+                        actual, expected,
+                        "n={n} bpk={bpk} len={len} offset={offset}"
+                    );
+                    assert_eq!(actual[0], 0xfeed);
+                    assert_eq!(actual[len + 1], 0xfeed);
+                    for (&h, &v) in input.iter().zip(&actual[1..len + 1]) {
+                        assert_eq!(v, new.contains_hash(h) as u32);
+                    }
+                }
+            }
+            assert_eq!(
+                bitmap,
+                new.lines.iter().flat_map(|line| line.0).collect::<Vec<_>>()
+            );
+        }
+    }
